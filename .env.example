# Copy to .env for local dev only. NEVER commit a real .env.
# In Vercel these are set in Dashboard -> hkcn-news-app -> Settings ->
# Environment Variables (Production + Preview). Values below are placeholders.
#
# Database (Supabase — database ONLY, not storage):
SUPABASE_URL=https://<your-news-project>.supabase.co
SUPABASE_SERVICE_KEY=<service_role key — server-side only, never in the browser>
# Optional: anon key is not needed by this app (reads go through the API).
#
# Images (Cloudflare R2 — primary image store):
# Staging (verified 2026-11-13, bucket hkcn-news-images, currently empty):
R2_PUBLIC_BASE_URL=https://pub-a67cbc14cf5144078bec88dddadc485d.r2.dev
# Production later, once hkcnexpress.com moves to Cloudflare DNS and the
# custom domain is connected: https://images.hkcnexpress.com
# (R2_PUBLIC_BASE_URL is read at runtime; switching is env-only, no deploy of code logic needed — but a redeploy picks up the new env value.)
# R2 upload credentials are NOT used by this web app. Uploads happen from the
# Bella publishing pipeline, which holds its own S3-compatible R2 token.
#
# Publishing endpoint secret (Bella pipeline only):
INGEST_SECRET=<long random string — set in Vercel AND in the pipeline>
#
# Public site URL used for og:url / sitemap / RSS links.
# Leave empty on Vercel: it is derived from the request host.
SITE_URL=https://hkcnexpress.com
#
# Admin (Google SSO only — no passwords anywhere):
# GOOGLE_CLIENT_ID: the OAuth client id from Google Cloud Console (public id,
#   not a secret). The OAuth client must allow the redirect/origin for
#   https://hkcn-news-app-eva318chan.vercel.app and the callback
#   /api/admin/auth/callback.
GOOGLE_CLIENT_ID=<google oauth client id>.apps.googleusercontent.com
# ADMIN_EMAILS: comma-separated allowlist — only these Google accounts can
#   sign in to /admin/ (e.g. eddiehlk@gmail.com,eva318.chan@gmail.com).
ADMIN_EMAILS=eddiehlk@gmail.com
# ADMIN_SESSION_SECRET: long random string; HMAC key for the admin session
#   cookie. Server-side only, never in the browser or repo.
ADMIN_SESSION_SECRET=<redacted>
