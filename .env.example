# Copy to .env for local dev only. NEVER commit a real .env.
# In Vercel these are set in Dashboard -> hkcn-news-app -> Settings ->
# Environment Variables (Production + Preview). Values below are placeholders.
#
# Database (Supabase — database ONLY, not storage):
SUPABASE_URL=https://<your-news-project>.supabase.co
SUPABASE_SERVICE_KEY=<service_role key — server-side only, never in the browser>
# Optional: anon key is not needed by this app (reads go through the API).
#
# Images (Cloudflare R2 — primary image store):
R2_PUBLIC_BASE_URL=https://images.hkcnexpress.com
# R2 upload credentials are NOT used by this web app. Uploads happen from the
# Bella publishing pipeline, which holds its own S3-compatible R2 token.
#
# Publishing endpoint secret (Bella pipeline only):
INGEST_SECRET=<long random string — set in Vercel AND in the pipeline>
#
# Public site URL used for og:url / sitemap / RSS links.
# Leave empty on Vercel: it is derived from the request host.
SITE_URL=https://hkcnexpress.com
